# =================================================================
# PEARL & POLISHH ATELIER PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================

# Node Environment Mode ('development' | 'production')
NODE_ENV=development

# Application HTTP Port (Default: 3000)
PORT=3000

# Client Web Application Origins (Used for CORS and CSFR origin validation)
CLIENT_URL=http://localhost:5173
APP_URL=https://pearlandpolish.com

# MongoDB Atlas Connection URI (REQUIRED in production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/pearl_and_polishh?retryWrites=true&w=majority

# JWT Token Cryptographic Secret Keys (REQUIRED in production - Minimum 32 chars)
JWT_SECRET=production_jwt_access_token_secret_key_change_me_32chars
JWT_REFRESH_SECRET=production_jwt_refresh_token_secret_key_change_me_32chars

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Admin Access Control Whitelist (Comma-separated lowercase emails)
ADMIN_GOOGLE_EMAILS=tanaynagpal5@gmail.com,maanvinagpal18@gmail.com,maanvinagpal1@gmail.com

# Cloudinary Media Storage Credentials (REQUIRED for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Admin Seeding Credentials (Only used during first database init)
ADMIN_INITIAL_EMAIL=admin@pearlandpolish.com
ADMIN_INITIAL_PASSWORD=ChangeAdminPass2026!

# Google Gemini AI API Key (Optional for AI custom press-on assistant)
GEMINI_API_KEY=your_gemini_api_key

# Optional Analytics Integration Identifiers (Left blank if unused)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_CLARITY_ID=
VITE_META_PIXEL_ID=
